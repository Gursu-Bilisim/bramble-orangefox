+// Samsung devices with an MDFPP (QSEE) gatekeeper register it as the "mdfpp"
+// instance, and Android verifies the credential there. The "default" instance
+// can take another path (for example the SPU on SM8250) and reject the same
+// credential. Prefer "mdfpp" when it is present, otherwise use "default".
+static android::sp<android::hardware::gatekeeper::V1_0::IGatekeeper> getGatekeeperService() {
+	auto gk = ::android::hardware::gatekeeper::V1_0::IGatekeeper::tryGetService("mdfpp");
+	if (gk == nullptr)
+		gk = ::android::hardware::gatekeeper::V1_0::IGatekeeper::getService();
+	return gk;
+}
